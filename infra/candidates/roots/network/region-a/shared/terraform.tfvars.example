  ram_principal_arns = [
    "arn:aws:organizations::REPLACE_WITH_MANAGEMENT_ACCOUNT_ID:organization/REPLACE_WITH_ORGANIZATION_ID",
  ]
}

tags = {
  Application = "platform"
  CostCenter  = "REPLACE_WITH_APPROVED_VALUE"
  Owner       = "REPLACE_WITH_APPROVED_VALUE"
}
