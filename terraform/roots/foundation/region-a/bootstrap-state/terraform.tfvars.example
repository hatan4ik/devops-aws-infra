# Keep the working copy as an ignored *.tfvars file. These are resource
# identifiers, not credentials; the account ID is supplied at runtime after
# STS identity verification.
aws_region     = "REPLACE_WITH_APPROVED_REGION"
aws_account_id = "REPLACE_WITH_APPROVED_ACCOUNT_ID"

bucket_name         = "REPLACE_WITH_APPROVED_BUCKET_NAME"
dynamodb_table_name = "REPLACE_WITH_APPROVED_LOCK_TABLE_NAME"
kms_key_alias       = "REPLACE_WITH_APPROVED_KMS_ALIAS"
kms_key_description = "REPLACE_WITH_APPROVED_KMS_DESCRIPTION"

tags = {
  Environment = "shared"
  Layer       = "shared-services"
  ManagedBy   = "Terraform"
  Module      = "legacy-state-backend-adoption"
  Project     = "platform-aws-platform"
}
