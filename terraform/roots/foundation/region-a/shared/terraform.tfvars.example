# Copy reviewed non-secret values into terraform.tfvars only after the bootstrap change record is approved.
aws_region     = "REPLACE_WITH_APPROVED_REGION"
aws_replica_region = "REPLACE_WITH_APPROVED_REPLICA_REGION"
aws_account_id = "REPLACE_WITH_SHARED_SERVICES_ACCOUNT_ID"

state_backend = {
  name_prefix            = "REPLACE_WITH_APPROVED_PREFIX"
  access_log_bucket_name = "REPLACE_WITH_CENTRAL_ACCESS_LOG_BUCKET"
  access_log_prefix      = "REPLACE_WITH_APPROVED_PREFIX/terraform-state"
  state_tiers = {
    dev = {
      bucket_name                           = "REPLACE_WITH_DEV_BUCKET"
      replica_bucket_name                   = "REPLACE_WITH_DEV_REPLICA_BUCKET"
      noncurrent_version_expiration_in_days        = 90
      abort_incomplete_multipart_upload_after_days = 7
      object_lock = {
        enabled        = true
        retention_mode = "COMPLIANCE"
        retention_days = 14
      }
    }
    staging = {
      bucket_name                           = "REPLACE_WITH_STAGING_BUCKET"
      replica_bucket_name                   = "REPLACE_WITH_STAGING_REPLICA_BUCKET"
      noncurrent_version_expiration_in_days        = 90
      abort_incomplete_multipart_upload_after_days = 7
      object_lock = {
        enabled        = true
        retention_mode = "COMPLIANCE"
        retention_days = 14
      }
    }
    prod = {
      bucket_name                           = "REPLACE_WITH_PROD_BUCKET"
      replica_bucket_name                   = "REPLACE_WITH_PROD_REPLICA_BUCKET"
      noncurrent_version_expiration_in_days        = 90
      abort_incomplete_multipart_upload_after_days = 7
      object_lock = {
        enabled        = true
        retention_mode = "COMPLIANCE"
        retention_days = 14
      }
    }
  }
  state_access_principal_arns = [
    "arn:aws:iam::REPLACE_WITH_ACCOUNT_ID:role/REPLACE_WITH_CI_ROLE",
    "arn:aws:iam::REPLACE_WITH_ACCOUNT_ID:role/REPLACE_WITH_BREAK_GLASS_ROLE",
  ]
  kms_key_deletion_window_in_days = 30
  key_administrator_arns = [
    "arn:aws:iam::REPLACE_WITH_ACCOUNT_ID:role/REPLACE_WITH_KEY_ADMIN_ROLE",
  ]
}

tags = {
  Application = "platform"
  CostCenter  = "REPLACE_WITH_APPROVED_VALUE"
  Owner       = "REPLACE_WITH_APPROVED_VALUE"
}
